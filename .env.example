RUSTYSOUL_IMAGE=ghcr.io/salnajjar/rustysoul:beta
# Optional deployment defaults, only used for an empty database.
# You can leave these as the defaults as you will be prompted to change them on first sign-in.
RUSTYSOUL_DEFAULT_USERNAME=admin
RUSTYSOUL_DEFAULT_PASSWORD=change-me-now
# Initial transfer TCP port. Host networking allows later UI changes; bridge mode publishes this port.
RUSTYSOUL_TRANSFER_PORT=2234
# Optional host bind paths for Compose; omit to use separate named volumes.
# RUSTYSOUL_DOWNLOADS_SOURCE=/srv/downloads/rustysoul
# RUSTYSOUL_LIBRARY_SOURCE=/srv/music
